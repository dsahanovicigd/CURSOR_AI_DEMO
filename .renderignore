# Render ignore file - similar to .gitignore
# Files and directories to exclude from deployment

# Development files
.env
.env.local
.env.*.local
*.log
*.pid

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/
.venv

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Testing
.coverage
htmlcov/
.pytest_cache/
.tox/
test-results/
playwright-report/
coverage/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Documentation
*.md
!README.md

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml

# QA/Testing
qa-automation/
qa/
tests/

# Build artifacts (keep dist for frontend)
*.map
*.backup
