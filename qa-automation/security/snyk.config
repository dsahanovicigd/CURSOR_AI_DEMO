# Snyk Configuration
# Security vulnerability scanning configuration

language-settings:
  python:
    manager: "pip"
    targetFile: "flask_api/requirements.txt"
  
  javascript:
    manager: "npm"
    targetFile: "package.json"

severity-threshold: "medium"

fail-on: "high"

exclude:
  - "**/node_modules/**"
  - "**/dist/**"
  - "**/build/**"
  - "**/.venv/**"
  - "**/venv/**"

monitor: true

report: true

report-format: ["json", "html"]

output-dir: "../reports/snyk-reports"
