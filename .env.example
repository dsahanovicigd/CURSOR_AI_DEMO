# Frontend Environment Variables (for Vercel)
# Copy these to Vercel Dashboard → Project Settings → Environment Variables

# Backend API URL - Replace with your actual backend URL
# Examples:
#   Railway: https://your-app-name.railway.app/api
#   Render: https://your-app-name.onrender.com/api
#   Custom: https://api.yourdomain.com/api
VITE_API_URL=http://localhost:5001/api

# Backend Environment Variables (for Railway/Render/etc.)
# These are NOT used by Vercel, but needed for backend deployment
#
# Render.com Setup:
# 1. Most variables are auto-configured via render.yaml
# 2. Set CORS_ORIGINS manually after frontend deployment
# 3. See RENDER_DEPLOYMENT_GUIDE.md for details

# Flask Secret Key (change in production!)
SECRET_KEY=your-secret-key-here-change-in-production

# JWT Secret Key (change in production!)
JWT_SECRET_KEY=your-jwt-secret-key-here-change-in-production

# Database URL
# Examples:
#   Railway: postgresql://user:pass@host:5432/dbname (provided by Railway)
#   Render: postgresql://user:pass@host:5432/dbname (provided by Render)
#   Local: postgresql://user:pass@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# CORS Origins (comma-separated list)
# Add your Vercel domain here after deployment
# Example: https://your-project.vercel.app,https://your-project-git-main.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Redis URL (if using Redis)
REDIS_URL=redis://localhost:6379/0

# Flask Environment
FLASK_ENV=production
FLASK_APP=app:create_app
